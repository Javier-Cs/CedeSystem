---



---
<section class="min-h-screen bg-[#09090b] text-white py-10 px-6">
  <div class="max-w-7xl mx-auto">



    <!-- Header -->
    <div class="text-center mb-10">
      
      <h1 class="mt-6 text-5xl md:text-7xl font-bold tracking-tight">
        PROYECTOS
      </h1>

      <p class="mt-6 max-w-3xl mx-auto text-zinc-400 text-lg md:text-xl">
        Desarrollo backend, APIs escalables, sistemas empresariales
        y aplicaciones web modernas.
      </p>

    </div>



    <!-- Grid -->
    <div class="grid gap-8 md:grid-cols-2 xl:grid-cols-3">

      {proyectos.map((proyecto) => (
        <article class="group relative overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/50 backdrop-blur-xl p-8
          transition-all duration-300 hover:border-red-500 hover:-translate-y-2 hover:shadow-[0_0_40px_rgba(34,211,238,0.08)]">

          <div class="relative z-10">

            <div class="flex items-start justify-between mb-6">
              <h2 class="text-2xl font-semibold">
                {proyecto.titulo}
              </h2>

              <span
                class={`px-3 py-1 rounded-full text-xs font-medium ${
                  estadoClasses[proyecto.estado] ?? "bg-gray-500/15 text-gray-400 border border-gray-500/20"
                }`}
              >
                {proyecto.estado}
              </span>

            </div>

            <p class="text-zinc-400 leading-relaxed mb-4">
              {proyecto.descripcion}
            </p>

            <div class="flex flex-wrap gap-1 mb-4">
              {proyecto.tecnologias.map((tech) => (
                <span class="rounded-full border border-zinc-700 bg-zinc-800/60 px-3 py-1 text-xs text-zinc-300">
                  {tech}
                </span>
              ))}
            </div>

            <a
              href={proyecto.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl bg-white px-5 py-3 text-sm font-medium text-black transition hover:scale-105">
              Ver proyecto

              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>

            </a>

          </div>

        </article>
      ))}

    </div>
  </div>
</section>