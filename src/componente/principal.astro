---
import LayoutIndex from "../layout/LayoutIndex.astro";
import SeccionDonacion from "../modulos/SeccionesDonacion.astro";
---

<LayoutIndex>
  <section
    class="
      relative
      overflow-hidden
      min-h-screen
      bg-white
      dark:bg-black
      text-black
      dark:text-white
      px-4
      py-4
    "
  >
    <!-- EFECTOS DE FONDO -->
    <div
      class="
        absolute
        top-0
        left-0
        w-full
        h-full
        overflow-hidden
        pointer-events-none
      "
    >
      <div
        class="
          absolute
          top-[-120px]
          left-[-120px]
          w-[400px]
          h-[400px]
          bg-zinc-300/20
          dark:bg-zinc-700/20
          blur-2xl
          rounded-full
        "
      />

      <div
        class="
          absolute
          bottom-[-150px]
          right-[-100px]
          w-[350px]
          h-[350px]
          bg-zinc-400/10
          dark:bg-white/10
          blur-3xl
          rounded-full
        "
      />
    </div>

    <!-- CONTENEDOR -->
    <div
      class="
        relative
        z-10
        min-h-[96vh]
        border
        border-zinc-300/40
        dark:border-zinc-700
        backdrop-blur-xl
        bg-white/40
        dark:bg-white/5
        rounded-3xl
        flex
        flex-col
        justify-center
        items-center
        px-6
        py-20
        shadow-2xl
      "
    >
      <!-- BADGE -->
      <div
        class="
          mb-6
          px-5
          py-2
          rounded-full
          border
          border-zinc-300
          dark:border-zinc-700
          text-sm
          tracking-[0.3em]
          uppercase
          bg-white/30
          dark:bg-white/5
          backdrop-blur-md
        "
      >
        CedeSystem
      </div>
      <!-- LOGO 
      <img src="/public/LOG.webp" alt="Logo de CedeSystem" class="w-90 h-30"/>-->

      

      <!-- TITULO -->
      <div class="text-center max-w-6xl">
        <h1
          class="
            text-7xl
            md:text-8xl
            font-black
            tracking-tight
            leading-none
          "
        >
          QUE HACES
          <span
            class="
              block
              text-transparent
              bg-clip-text
              bg-gradient-to-r
              from-zinc-500
              to-zinc-900
              dark:from-zinc-200
              dark:to-zinc-500
            "
          >
            AQUI?
          </span>
        </h1>

        <p
          class="
            mt-10
            text-xl
            md:text-3xl
            font-light
            leading-relaxed
            text-zinc-700
            dark:text-zinc-300
          "
        >
          CedeSystem es una pequeña startup que tiene
          un único desarrollador backend junior explotado por su jefe.

        </p>

        <p
          class="
            mt-6
            text-lg
            md:text-2xl
            text-zinc-500
            dark:text-zinc-400
          "
        >
          por ahora...
        </p>

        <p
          class="
            mt-10
            text-1xl
            md:text-1xl
            font-light
            text-zinc-600
            dark:text-zinc-400
          "
        >
          puedes apoyar al pobre ser o simplemente mirar
          las cosas raras que estoy construyendo.
        </p>
        <p
          class="
            text-lg
            md:text-1xl
            font-light
            text-zinc-600
            dark:text-zinc-400
          "
        >
          esta* XD
        </p>
      </div>

      <SeccionDonacion />

      <!-- BOTONES -->
      <div
        class="
          mt-10
          flex
          flex-col
          md:flex-row
          gap-9
          items-center
        "
      >
        <!-- DONACION -->
        <button
          onclick="openDonationModal()"
          class="
            group
            relative
            overflow-hidden
            px-9
            py-3
            rounded-2xl
            bg-black
            dark:bg-white
            text-white
            dark:text-black
            font-semibold
            tracking-wide
            transition-all
            duration-300
            hover:scale-105
            shadow-xl
          "
        >
          <span class="relative z-10">
            Hacer una donación
          </span>

          
        </button>

        <!-- PROYECTOS -->
        <button
          onclick="window.location.href='/proyectos'"
          class="
            px-9
            py-3
            rounded-2xl
            border
            border-zinc-300
            dark:border-zinc-700
            backdrop-blur-xl
            bg-white/20
            dark:bg-white/5
            hover:bg-zinc-200
            dark:hover:bg-white/10
            transition-all
            duration-300
            hover:scale-105
            text-lg
          "
        >
          Ver Proyectos
        </button>
      </div>

      </div>
    </div>
  </section>
</LayoutIndex>